      "source": [
        "all_saccade_collection = pd.read_csv(collection_path)\n",
        "required = [\"animal\", \"block\", \"Main\", \"Sub\", \"saccade_on_ms\"]\n",
        "missing = [c for c in required if c not in all_saccade_collection.columns]\n",
